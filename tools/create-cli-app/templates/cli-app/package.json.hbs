{
  "name": "{{appName name}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig ./tsconfig.json --watch src/index.ts",
    "debug": "tsx --tsconfig ./tsconfig.json --watch src/index.ts --inspect-brk=9229",
    "clean": "shx rm -rf .jest-cache coverage dist node_modules",
    "prebuild": "tsc -b && npm run clean",
    "build": "tsx esbuild.config.ts",
    "test": "jest tests/unit --silent",
    "test:watch": "jest tests/unit --watch --silent",
    "start": "node dist/index"
  },
  "dependencies": {
    "shared": "*"
  }
}
